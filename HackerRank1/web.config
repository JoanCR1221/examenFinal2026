<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\HackerRank1.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Reemplazar con la cadena de conexion real de Supabase (Project Settings > Database > .NET) -->
          <environmentVariable name="ConnectionStrings__DefaultConnection"
                               value="REEMPLAZAR_CON_CADENA_SUPABASE" />
          <!-- Origenes CORS permitidos: agregar la URL de Netlify cuando este desplegado el Frontend -->
          <environmentVariable name="Cors__AllowedOrigins__0" value="http://localhost:5173" />
          <environmentVariable name="Cors__AllowedOrigins__1" value="REEMPLAZAR_CON_URL_NETLIFY" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
